APP_BASE_URL=https://pharmareen--pal895.replit.app
WHATSAPP_PROVIDER=whatsapp_web
WHATSAPP_NUMBER=
# Temporary development override only. Production pharmacy numbers belong in the Google Sheets Pharmacies registry.
# Example for controlled live test: 254721149472
ALLOWED_WHATSAPP_NUMBERS=
PHARMACY_REGISTRY_AUTH_ENABLED=true
# Phase 2 test only. If true, direct @s.whatsapp.net and @lid chats are accepted after group/broadcast checks.
ALLOW_ALL_DIRECT_CHATS_FOR_TEST=false
OWNER_WHATSAPP_TO=
# If true, uses local sample data and does not write pharmacy records to Google Sheets.
DEMO_MODE=false

# Meta is parked until business verification is ready.
META_VERIFY_TOKEN=pharmareen123
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0
MS20_VERIFICATION_PROVIDER=meta_whatsapp
# Approved WhatsApp authentication template with one body variable for the six-digit code.
META_VERIFICATION_TEMPLATE_NAME=
META_VERIFICATION_TEMPLATE_LANGUAGE=en

GOOGLE_SHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=
PHARMAREEN_ADMIN_SHEET_ID=
PHARMAREEN_DEFAULT_PHARMACY_ID=
# Platform-wide production edge signing key. The edge supplies a verified
# request-scoped tenant binding; never create one environment variable per pharmacy.
PHARMAREEN_TENANT_ROUTING_KEY=
# Internal emergency/bootstrap access for platform administrators only. Never use as an owner login.
PHARMAREEN_ADMIN_ACCESS_TOKEN=

OPENAI_API_KEY=
ENABLE_VOICE_INPUT=true

REPORT_STORAGE_MODE=local
REPORT_PUBLIC_DIR=reports_pdf

# WhatsApp Web MVP bridge
PHARMAREEN_BACKEND_URL=http://localhost:5000
WHATSAPP_WEB_SESSION_PATH=.wwebjs_auth
WHATSAPP_WEB_CHROME_PATH=
BAILEYS_SESSION_PATH=.baileys_auth
ENABLE_BAILEYS_FALLBACK=true
